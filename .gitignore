# OS
.DS_Store

# IDE
.idea/
*.iml
*.iws
*.ipr
.idea_modules/
out/
.vscode/

# Build outputs
target/
**/target/

# JVM 크래시/attach 산출물
hs_err_pid*
replay_pid*
.attach_pid*

# Maven wrapper
# 래퍼는 only-script 타입이라 jar가 없다(mvnw + maven-wrapper.properties만 커밋).
# type=bin 으로 재생성하면 이 줄을 지우고 jar를 커밋해야 한다.
.mvn/wrapper/maven-wrapper.jar

# Runtime files
**/logs/*
logs/
*.log

# Environment files
.env
.env.*
# 예시 파일은 비밀값이 없고 문서가 가리키는 대상이다. 무시하면 수정이 조용히 사라진다.
!front/.env.local.example

# Local AI/MCP config
.ai/mcp/mcp.json

# Docker local data
.docker-compose/.docker-volumes/

#python 제외 파일
scripts/__pycache__/
*.pyc


# Node 의존성
front/node_modules/

# 빌드 결과물
front/.next/
front/.next*/
front/out/

# 환경변수 파일
front/.env
front/.env.local
front/.env.development.local
front/.env.test.local
front/.env.production.local

# OS/IDE 생성 파일
front/.DS_Store
front/*.log
front/.idea/
front/.vscode/
front/node_modules

# 패키지 매니저 캐시
front/npm-debug.log*
front/yarn-debug.log*
front/yarn-error.log*
front/pnpm-debug.log*

# 멀티모듈 로컬 산출물
*/logs/
front/tsconfig.tsbuildinfo
front/pnpm-lock.yaml
*/.docker-volumes/

# 개발 스크립트가 남기는 실행 PID
*.pid
